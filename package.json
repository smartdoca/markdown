{
  "name": "@smartdoca/markdown",
  "version": "0.4.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "concurrently -n web,sync -c cyan,magenta \"vite\" \"y-websocket\"",
    "dev:web": "vite",
    "dev:sync": "y-websocket",
    "build": "yarn build:lib && yarn build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:contract": "yarn build:lib && node --test tests/contract.test.mjs",
    "test:idle": "yarn build:lib && node --test tests/idle.test.mjs",
    "test:files": "yarn build:lib && node --test tests/markdown-file.test.mjs",
    "test:pdf": "yarn build:lib && node --test tests/pdf-file.test.mjs",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.mjs",
    "test:browser": "yarn build:lib && vite --host 127.0.0.1 --port 5198 --strictPort --open /tests/browser/index.html",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "yjs": "^13.6.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.3",
    "@lezer/highlight": "^1.2.1",
    "@napi-rs/canvas": "^0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "@uiw/react-codemirror": "^4.25.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "lucide-react": "^0.542.0",
    "mermaid": "^11.10.1",
    "micromark": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-string": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "1.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "yjs": "^13.6.27"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartdoca/markdown.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
